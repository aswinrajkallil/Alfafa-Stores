     $('span.minus').click(function(){
        
        var chislo = parseInt($(this).next().html())-1;
        
        if(chislo<1) chislo=1;
        
        $(this).next().html(chislo);
        
     });
     $('span.plus').click(function(){
        
        var chislo = parseInt($(this).prev().html())+1;
        $(this).prev().html(chislo);
        
     });   
     
     
     
     //выполняем пересчёт корзины
     $('span[id^="minus_"], span[id^="plus_"]').click(function(){
        
        var ids = $(this).attr('id');
       
       ids=ids.replace(/minus_/gi, '');
       ids=ids.replace(/plus_/gi, '');
        
       var count = $('#amount_'+ids).html();
       
       savesum(count,$('[id="uniqid_'+ids+'"]').val());
       
       var innitialprice = $('#price_'+ids).val();
        
       var suma = innitialprice*count;
       suma=number_format(suma, 2, '.', '');
       
       $('#total_'+ids).html('AED '+suma);
       
       //выбираем все суммы
       var total = 0;
       
       $sumy = $('[id^="total_"]');
       $sumy.each(function(){
        
            var vals = this.innerHTML;
            vals=vals.replace(/AED /gi, '');
            vals = parseFloat(vals);
            total+=vals;
            
       });
       $('.total').html('AED '+number_format(total, 2, '.', ''));
       
       if(document.getElementById('discount')) {
            var disc = parseFloat($('#discount').val())*total;
            disc = number_format(disc, 2, '.', '');
            $('.discount').html('AED '+disc);
       }
       
       var itogo = total - disc;
       itogo = number_format(itogo, 2, '.', '');
       $('.itogo').html('AED '+itogo);
        
     });
     
     
